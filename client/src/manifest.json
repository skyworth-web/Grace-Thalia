{
  "manifest_version": 3,
  "name": "Interview Co-Pilot+ (LangChain)",
  "version": "1.0.0",
  "description": "Real-time AI interview assistant powered by GPT-4o and LangChain",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://teams.microsoft.com/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*"
      ],
      "js": ["content/contentScript.js"],
      "css": []
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Interview Co-Pilot+"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["content/*.js", "content/*.css", "pdf.worker.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
  