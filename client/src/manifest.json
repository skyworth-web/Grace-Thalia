{
  "manifest_version": 3,
  "name": "Interview Co-Pilot+",
  "version": "1.0.0",
  "description": "AI powered interview co-pilot with real-time caption capture.",

  "permissions": [
    "scripting",
    "tabCapture",
    "activeTab",
    "storage"
  ],

  "host_permissions": [
    "*://meet.google.com/*",
    "*://*.zoom.us/*",
    "*://zoom.us/*",
    "*://teams.microsoft.com/*",
    "http://localhost:8000/*"
  ],

  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "*://meet.google.com/*",
        "*://*.zoom.us/*",
        "*://zoom.us/*",
        "*://teams.microsoft.com/*"
      ],
      "js": ["content/contentRaw.js"],
      "run_at": "document_end"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Interview Co-Pilot+"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "pdf.worker.min.js",
        "content/*.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
